generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  role         Role              @default(EMPLOYEE)
  isBlocked    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  orderNotes   OrderNote[]
  statusLogs   OrderStatusLog[]
  refunds      Refund[]
  stockAdjusts StockAdjustment[]

  @@map("admin_user")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime

  @@map("password_reset_token")
}

model StoreSettings {

  id           String   @id @default(uuid())
  name         String
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  taxRate      Float    @default(0)
  taxInclusive Boolean  @default(false)
  codEnabled   Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("store_settings")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("category")
}

model Product {
  id                String             @id @default(uuid())
  categoryId        String
  name              String
  description       String?
  basePrice         Float
  status            ProductStatus      @default(DRAFT)
  lowStockThreshold Int                @default(5)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          Category           @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  attributes        VariantAttribute[]

  @@map("product")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  position  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@map("product_image")
}

model VariantAttribute {
  id        String            @id @default(uuid())
  productId String
  name      String
  options   AttributeOption[]
  product   Product           @relation(fields: [productId], references: [id])

  @@map("variant_attribute")
}

model AttributeOption {
  id          String             @id @default(uuid())
  attributeId String
  value       String
  attribute   VariantAttribute   @relation(fields: [attributeId], references: [id])
  variantMaps VariantOptionMap[]

  @@map("attribute_option")
}

model ProductVariant {
  id                String             @id @default(uuid())
  productId         String
  sku               String             @unique
  priceOverride     Float?
  stockQty          Int                @default(0)
  lowStockThreshold Int                @default(5)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  orderItems        OrderItem[]
  product           Product            @relation(fields: [productId], references: [id])
  stockAdjustments  StockAdjustment[]
  optionMaps        VariantOptionMap[]

  @@map("product_variant")
}

model VariantOptionMap {
  id        String          @id @default(uuid())
  variantId String
  optionId  String
  option    AttributeOption @relation(fields: [optionId], references: [id])
  variant   ProductVariant  @relation(fields: [variantId], references: [id])

  @@map("variant_option_map")
}

model StockAdjustment {
  id             String         @id @default(uuid())
  variantId      String
  adminId        String
  quantityChange Int
  reason         String
  createdAt      DateTime       @default(now())
  admin          AdminUser      @relation(fields: [adminId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@map("stock_adjustment")
}

model Customer {
  id          String            @id @default(uuid())
  name        String
  email       String            @unique
  phone       String?
  isBlocked   Boolean           @default(false)
  blockReason String?
  blockedAt   DateTime?
  createdAt   DateTime          @default(now())
  addresses   CustomerAddress[]
  orders      Order[]

  @@map("customer")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  line1      String
  line2      String?
  city       String
  region     String
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id])
  orders     Order[]

  @@map("customer_address")
}

model Order {
  id            String           @id @default(uuid())
  customerId    String
  addressId     String
  orderNumber   String           @unique
  status        OrderStatus      @default(PENDING)
  paymentStatus PaymentStatus    @default(UNPAID)
  paymentMethod String
  paystackRef   String?
  subtotal      Float
  shippingFee   Float
  discount      Float            @default(0)
  total         Float
  createdAt     DateTime         @default(now())
  address       CustomerAddress  @relation(fields: [addressId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  notes         OrderNote[]
  statusLogs    OrderStatusLog[]
  refunds       Refund[]

  @@map("order")
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  variantId   String?
  productName String
  variantName String
  sku         String
  unitPrice   Float
  quantity    Int
  subtotal    Float
  order       Order           @relation(fields: [orderId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_item")
}

model OrderStatusLog {
  id        String      @id @default(uuid())
  orderId   String
  adminId   String
  status    OrderStatus
  createdAt DateTime    @default(now())
  admin     AdminUser   @relation(fields: [adminId], references: [id])
  order     Order       @relation(fields: [orderId], references: [id])

  @@map("order_status_log")
}

model OrderNote {
  id        String    @id @default(uuid())
  orderId   String
  adminId   String
  note      String
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@map("order_note")
}

model Refund {
  id        String    @id @default(uuid())
  orderId   String
  adminId   String
  amount    Float
  reason    String
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@map("refund")
}

model ShippingZone {
  id            String               @id @default(uuid())
  name          String
  flatRate      Float
  freeThreshold Float?
  codEnabled    Boolean              @default(false)
  regions       ShippingZoneRegion[]

  @@map("shipping_zone")
}

model ShippingZoneRegion {
  id         String       @id @default(uuid())
  zoneId     String
  regionName String
  zone       ShippingZone @relation(fields: [zoneId], references: [id])

  @@map("shipping_zone_region")
}

model NotificationSetting {
  id             String  @id @default(uuid())
  event          String  @unique
  isEnabled      Boolean @default(true)
  recipientEmail String?

  @@map("notification_setting")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
